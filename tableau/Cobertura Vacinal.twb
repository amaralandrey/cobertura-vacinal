      <aliases enabled='yes' />
      <column caption='Destaque Norte' datatype='string' name='[Calculation_0014564438515745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [territorio] = &quot;Norte&quot; THEN &quot;Norte&quot; ELSE &quot;Outras regiões&quot; END' />
      </column>
      <column caption=' Comparação PA' datatype='string' name='[Calculation_0014564457893930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [nivel] = &quot;Brasil&quot; THEN &quot;Brasil&quot;&#10;ELSEIF [nivel] = &quot;Região&quot; AND [territorio] = &quot;Norte&quot; THEN &quot;Região Norte&quot;&#10;ELSEIF [nivel] = &quot;UF&quot; AND [sigla_uf] = &quot;PA&quot; THEN &quot;Pará&quot;&#10;END' />
      </column>
      <column caption=' Grupo UF' datatype='string' name='[Calculation_0014564458102828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sigla_uf] = &quot;PA&quot; THEN &quot;Pará&quot;&#10;ELSEIF [regiao] = &quot;Norte&quot; THEN &quot;Outras UFs do Norte&quot;&#10;ELSE &quot;Outros estados&quot;&#10;END' />
      </column>
      <column caption='Cobertura Brasil' datatype='real' name='[Calculation_0014564462231600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [ano], [vacina] : AVG(IF [nivel] = &quot;Brasil&quot; THEN [cobertura] END) }' />
